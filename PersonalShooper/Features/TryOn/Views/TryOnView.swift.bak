import SwiftUI
import PhotosUI

struct TryOnView: View {
    @Environment(AppState.self) private var appState
    @State private var viewModel = TryOnViewModel()
    @State private var showingSubscription = false
    @State private var showingPrivacyNotice = false
    @State private var hasAcceptedPrivacy = false
    @State private var showingImagePicker = false
    @State private var imagePickerSource: UIImagePickerController.SourceType = .camera
    @State private var capturePhase: CapturePhase = .clothing
    @State private var showingDownloadSuccess = false
    @State private var showingProviderSelector = false
    @State private var selectedProvider: TryOnProvider = .google

    private let providerService = TryOnProviderService()

    private var lang: Language {
        appState.preferredLanguage
    }

    enum CapturePhase {
        case clothing
        case selfie
        case result
    }

    var body: some View {
        NavigationStack {
            VStack(spacing: Theme.Spacing.lg) {
                // Provider selector bar
                providerSelectorBar

                if let generatedImage = viewModel.generatedImage {
                    resultView(generatedImage)
                } else if viewModel.isGenerating {
                    processingView
                } else {
                    captureView
                }
            }
            .background(Theme.Colors.groupedBackground.ignoresSafeArea())
            .navigationTitle(Strings.tryOnTitle(lang))
            .sheet(isPresented: $showingSubscription) {
                SubscriptionView()
            }
            .sheet(isPresented: $showingPrivacyNotice) {
                PrivacyNoticeView {
                    hasAcceptedPrivacy = true
                }
            }
            .sheet(isPresented: $showingImagePicker) {
                ImagePicker(sourceType: imagePickerSource) { image in
                    handleImageSelected(image)
                }
            }
            .sheet(isPresented: $showingProviderSelector) {
                TryOnProviderSelectorView(selectedProvider: $selectedProvider)
            }
            .alert("Downloaded!", isPresented: $showingDownloadSuccess) {
                Button("OK", role: .cancel) {}
            } message: {
                Text("Image saved to your Photos library.")
            }
        }
    }

    private var providerSelectorBar: some View {
        Button {
            showingProviderSelector = true
        } label: {
            HStack {
                Image(systemName: selectedProvider.icon)
                    .font(.body)

                Text(selectedProvider.displayName)
                    .font(.subheadline)

                if selectedProvider.isCartoonStyle {
                    Text("CARTOON")
                        .font(.caption2)
                        .fontWeight(.bold)
                        .foregroundStyle(.white)
                        .padding(.horizontal, 4)
                        .padding(.vertical, 2)
                        .background(Color.purple)
                        .clipShape(Capsule())
                }

                Spacer()

                Image(systemName: "chevron.up.chevron.down")
                    .font(.caption)
            }
            .padding(.horizontal, Theme.Spacing.md)
            .padding(.vertical, Theme.Spacing.sm)
            .background(Theme.Colors.cardBackground)
            .clipShape(RoundedRectangle(cornerRadius: Theme.CornerRadius.medium))
        }
        .buttonStyle(.plain)
        .padding(.horizontal)
        .padding(.top, Theme.Spacing.sm)
    }

    private var captureView: some View {
        VStack(spacing: Theme.Spacing.lg) {
            Spacer()

            Image(systemName: capturePhase == .clothing ? "tshirt.fill" : "person.fill")
                .font(.system(size: 80))
                .foregroundStyle(Theme.Colors.primary)

            Text(capturePhase == .clothing ? Strings.tryOnTakePhotoClothing(lang) : Strings.tryOnTakePhotoSelf(lang))
                .font(.title)
                .fontWeight(.bold)
                .multilineTextAlignment(.center)

            Text(capturePhase == .clothing ? Strings.tryonCaptureClothingDesc(lang) : Strings.tryonCaptureSelfDesc(lang))
                .font(.body)
                .foregroundStyle(.secondary)
                .multilineTextAlignment(.center)
                .padding(.horizontal, Theme.Spacing.xl)

            if selectedProvider.isCartoonStyle {
                Text("🎨 Estilo caricatura")
                    .font(.caption)
                    .foregroundStyle(.purple)
            }

            Spacer()

            Button {
                if !hasAcceptedPrivacy {
                    showingPrivacyNotice = true
                } else {
                    imagePickerSource = .camera
                    showingImagePicker = true
                }
            } label: {
                Label(
                    capturePhase == .clothing ? Strings.takePhotoClothing(lang) : Strings.takePhotoSelf(lang),
                    systemImage: "camera.fill"
                )
                .font(.headline)
                .padding()
                .frame(maxWidth: .infinity)
                .background(Theme.Colors.primary)
                .foregroundStyle(.white)
                .clipShape(RoundedRectangle(cornerRadius: 12))
            }
            .padding(.horizontal, Theme.Spacing.lg)

            if capturePhase == .clothing {
                Button {
                    imagePickerSource = .photoLibrary
                    showingImagePicker = true
                } label: {
                    Label(Strings.chooseFromLibrary(lang), systemImage: "photo.on.rectangle")
                        .font(.subheadline)
                        .foregroundStyle(Theme.Colors.primary)
                }
            }

            Spacer()
        }
    }

    private var processingView: some View {
        VStack(spacing: Theme.Spacing.lg) {
            Spacer()

            ProgressView()
                .scaleEffect(2)
                .padding()

            Text(Strings.tryOnProcessing(lang))
                .font(.title2)
                .fontWeight(.bold)

            Text(Strings.tryOnProcessingDesc(lang))
                .font(.body)
                .foregroundStyle(.secondary)
                .multilineTextAlignment(.center)
                .padding(.horizontal, Theme.Spacing.xl)

            Spacer()
        }
    }

    private func resultView(_ image: UIImage) -> some View {
        VStack(spacing: Theme.Spacing.lg) {
            Spacer()

            Text(Strings.tryOnResultTitle(lang))
                .font(.title)
                .fontWeight(.bold)

            Image(uiImage: image)
                .resizable()
                .aspectRatio(contentMode: .fit)
                .frame(maxHeight: 400)
                .clipShape(RoundedRectangle(cornerRadius: Theme.CornerRadius.large))
                .padding(.horizontal, Theme.Spacing.lg)
                .shadow(color: .black.opacity(0.1), radius: 10)

            Spacer()

            HStack(spacing: Theme.Spacing.md) {
                Button {
                    saveToPhotos(image)
                } label: {
                    Label(Strings.downloadToPhotos(lang), systemImage: "square.and.arrow.down.fill")
                        .font(.headline)
                        .padding()
                        .frame(maxWidth: .infinity)
                        .background(Theme.Colors.primary)
                        .foregroundStyle(.white)
                        .clipShape(RoundedRectangle(cornerRadius: 12))
                }

                Button {
                    resetCapture()
                } label: {
                    Label(Strings.tryAgain(lang), systemImage: "arrow.counterclockwise")
                        .font(.headline)
                        .padding()
                        .frame(maxWidth: .infinity)
                        .background(Color.gray.opacity(0.2))
                        .foregroundStyle(.primary)
                        .clipShape(RoundedRectangle(cornerRadius: 12))
                }
            }
            .padding(.horizontal, Theme.Spacing.lg)

            Spacer()
        }
    }

    private func handleImageSelected(_ image: UIImage?) {
        guard let image = image else { return }

        if capturePhase == .clothing {
            viewModel.selectedClothingImage = image
            capturePhase = .selfie
        } else {
            viewModel.selectedUserImage = image
            Task {
                await viewModel.generateTryOn()
            }
        }
    }

    private func saveToPhotos(_ image: UIImage) {
        PHPhotoLibrary.requestAuthorization(for: .addOnly) { status in
            if status == .authorized || status == .limited {
                UIImageWriteToSavedPhotosAlbum(image, nil, nil, nil)
                DispatchQueue.main.async {
                    showingDownloadSuccess = true
                }
            }
        }
    }

    private func resetCapture() {
        viewModel.generatedImage = nil
        viewModel.selectedClothingImage = nil
        viewModel.selectedUserImage = nil
        capturePhase = .clothing
    }
}

#Preview {
    TryOnView()
        .environment(AppState())
}
