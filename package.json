{
  "name": "matchpoint-tennis",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "migrate:firestore": "node scripts/migrate-firestore-model.mjs",
    "i18n:validate": "node scripts/validate-i18n.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "landing:serve": "npx serve landing",
    "build:android-bundle": "expo export --platform android --output-dir dist-android",
    "build:android-aab": "./scripts/build-android-bundle.sh",
    "publish:android:closed": "node scripts/publish-google-play.mjs",
    "setup:android:products": "node scripts/setup-google-play-products.mjs",
    "check:android:closed": "node scripts/check-google-play.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:firestore:run": "node --import tsx --test tests/firestore-rules.integration.ts",
    "doctor": "npx expo-doctor",
    "verify": "npm run typecheck && npm test && npm run build:android-bundle && npm run doctor",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/app-check": "25.1.0",
    "@react-native-firebase/auth": "25.1.0",
    "@react-native-firebase/crashlytics": "25.1.0",
    "@react-native-firebase/firestore": "25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "~57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-iap": "4.7.0",
    "expo-image": "57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "57.0.4",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^16.4.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "^57.0.5",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "googleapis": "^173.0.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
