{
  "name": "tennis-club-matcher",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "migrate:firestore": "node scripts/migrate-firestore-model.mjs",
    "i18n:validate": "node scripts/validate-i18n.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "landing:serve": "npx serve landing",
    "build:android-bundle": "expo export --platform android --output-dir dist-android",
    "build:android-aab": "./scripts/build-android-bundle.sh",
    "publish:android:closed": "node scripts/publish-google-play.mjs",
    "setup:android:products": "node scripts/setup-google-play-products.mjs",
    "check:android:closed": "node scripts/check-google-play.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:firestore:run": "node --import tsx --test tests/firestore-rules.integration.ts",
    "doctor": "npx expo-doctor",
    "verify": "npm run typecheck && npm test && npm run build:android-bundle && npm run doctor",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/app-check": "25.1.0",
    "@react-native-firebase/auth": "25.1.0",
    "@react-native-firebase/crashlytics": "25.1.0",
    "@react-native-firebase/firestore": "25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-application": "~6.0.2",
    "expo-asset": "~11.0.5",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.2",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.0",
    "expo-iap": "2.4.4",
    "expo-image": "~2.0.7",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "expo-symbols": "~0.2.2",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-view-shot": "~4.0.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "~18.3.12",
    "firebase": "10.14.1",
    "firebase-admin": "^14.1.0",
    "googleapis": "^173.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.6.3"
  },
  "description": "App multiplataforma para clubes de tenis. Permite registrar jugadores, buscar rivales por club, nivel, edad, formatos y disponibilidad, y publicar/aceptar propuestas de partido con reserva de cancha y horario.",
  "keywords": [],
