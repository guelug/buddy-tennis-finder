# ---- App (existente) ----
EXPO_PUBLIC_API_URL=https://your-api.example.com
EXPO_PUBLIC_APP_URL=https://tenisbuddy-app.web.app
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6793740051

# ---- Google Sign In (OAuth) ----
# El web client ID se usa como serverClientId para obtener el token nativo.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ---- Compras (anuncios de entrenador, ligas privadas) ----
# Por defecto (vacío/"false") quedan ocultas en ambas plataformas: no hace
# falta Firebase Functions ni Blaze para que la app arranque. Ver TODOs en
# src/lib/features.ts y functions/index.js antes de activarlas.
EXPO_PUBLIC_ANDROID_PURCHASES_ENABLED=false
EXPO_PUBLIC_IOS_PURCHASES_ENABLED=false
