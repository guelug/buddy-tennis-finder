# ---- App ----
EXPO_PUBLIC_APP_URL=https://tennisleagueapp.win
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6793740051

# Los client IDs públicos de Google Sign-In están versionados en
# src/lib/google-oauth-config.ts para que los builds nativos no dependan de
# variables locales.

# ---- Compras (anuncios de entrenador, ligas privadas) ----
# Ambas plataformas usan el mismo verificador server-side (Cloudflare Worker)
# protegido por Firebase Auth + App Check.
EXPO_PUBLIC_SECURE_BACKEND_URL=https://matchpoint-iap-verifier.guelug.workers.dev
EXPO_PUBLIC_IOS_PURCHASES_ENABLED=true
EXPO_PUBLIC_ANDROID_PURCHASES_ENABLED=true
