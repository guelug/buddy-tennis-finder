# ---- App (existente) ----
EXPO_PUBLIC_API_URL=https://your-api.example.com
EXPO_PUBLIC_APP_URL=https://matchpoint-clubs.vercel.app

# ---- Firebase (Fase 1) ----
# Copia estos valores desde Firebase Console > Project Settings > Your apps > Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---- Google Sign In (OAuth) ----
# Crea este cliente en Google Cloud Console > APIs & Services > Credentials > OAuth client ID (tipo "Web application")
# Authorized JavaScript origins: tu dominio web (ej. https://matchpoint-clubs.vercel.app)
# Authorized redirect URIs: el callback de expo-auth-session (explica en README)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
