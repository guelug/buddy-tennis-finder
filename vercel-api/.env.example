# --- Image generation (try-on + optimize thumbnails) ---
# Preference order in code: fal.ai → OpenRouter → Gemini direct.
# fal.ai (recommended): key from https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key
# Edit model slug. Default if unset: fal-ai/nano-banana/edit
# For "Nano Banana 2" (Gemini 3 image) set: fal-ai/nano-banana-pro/edit
FAL_IMAGE_MODEL=fal-ai/nano-banana/edit

GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_CHAT_FALLBACK_MODEL=minimax/minimax-m2.7
OPENROUTER_CHAT_MAX_TOKENS=520
APP_PUBLIC_URL=https://personalshooper.rebka.co
APP_BUNDLE_ID=com.personalshooper.app
APP_APPLE_ID=6774502051
# Leave enabled in production. Set false only for isolated local tests without OCSP access.
APPLE_ENABLE_ONLINE_CHECKS=true
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
