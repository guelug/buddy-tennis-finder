rules_version = '2';

// Reglas de seguridad de Firestore para MatchPoint Tennis.
// Documentación: https://firebase.google.com/docs/firestore/security/rules
//
// Modelo de datos (Fase 1):
//   users/{uid}          → datos privados del usuario autenticado
//   players/{uid}        → perfil deportivo público (visible para otros jugadores)
//   clubs/{clubId}       → catálogo público de clubes
//   matches/{matchId}    → propuestas de partido (Fase 3 lo amplía con resultados)
//
// Despliegue:
//   firebase deploy --only firestore:rules
// (requiere Firebase CLI: https://firebase.google.com/docs/cli)

service cloud.firestore {
  match /databases/{database}/documents {

    function hasVerifiedIdentity() {
      return request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider in ["google.com", "apple.com"];
    }

    function hasValidPublicProfile(data, uid) {
      return data.id == uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.age is int
        && data.age >= 13
        && data.age <= 100
        && data.gender in ["female", "male", "other"]
        && data.accountRole in ["player", "coach", "both"]
        && data.clubIds is list
        && data.clubIds.size() > 0
        && data.clubIds.size() <= 8
        && data.level in ["novato", "d", "c", "b", "a"]
        && data.preferredFormats is list
        && data.preferredFormats.size() > 0
        && data.preferredFormats.size() <= 3
        && data.availability is list
        && data.availability.size() <= 7
        && data.bio is string
        && data.bio.size() <= 500
        && data.languages is list
        && data.languages.size() > 0
        && data.languages.size() <= 8
        && data.verified is bool
        && data.verified == hasVerifiedIdentity()
        && data.profileComplete == true;
    }

    // La autoevaluación inicial del onboarding es opcional; si llega, debe
    // traer exactamente los cinco ejes con valores numéricos entre 1 y 10.
    function hasValidSelfAssessment(data) {
      return !("skills" in data)
        || (
          data.skills is map
          && data.skills.keys().hasOnly(["consistency", "forehand", "backhand", "serve", "volley"])
          && data.skills.consistency is number
          && data.skills.consistency >= 1 && data.skills.consistency <= 10
          && data.skills.forehand is number
          && data.skills.forehand >= 1 && data.skills.forehand <= 10
          && data.skills.backhand is number
          && data.skills.backhand >= 1 && data.skills.backhand <= 10
          && data.skills.serve is number
          && data.skills.serve >= 1 && data.skills.serve <= 10
          && data.skills.volley is number
          && data.skills.volley >= 1 && data.skills.volley <= 10
        );
    }

    function isMatchParticipant(data, uid) {
      return (
          "participantIds" in data
          && data.participantIds is list
          && uid in data.participantIds
        )
        || ("fromPlayerId" in data && data.fromPlayerId == uid)
        || ("acceptedByPlayerId" in data && data.acceptedByPlayerId == uid);
    }

    // Campos comunes a cualquier partido, sea propuesta abierta o parte de
    // dobles. La reserva (club, pista, horario) y la ciudad son inmutables
    // después, así que aquí es donde hay que validarlas.
    function hasValidMatchBase() {
      return request.resource.data.fromPlayerId == request.auth.uid
        && request.resource.data.clubId is string
        && request.resource.data.clubId.size() > 0
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 80
        && request.resource.data.city
          == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.city
        && request.resource.data.court is int
        && request.resource.data.court >= 1
        // El catálogo tiene clubes con más de 6 canchas; el cliente valida
        // contra el total real del club y aquí solo ponemos un tope sanitario.
        && request.resource.data.court <= 24
        && request.resource.data.reservationTime is string
        && request.resource.data.startsAt is string
        && request.resource.data.proposedAt is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.division in ["novato", "d", "c", "b", "a"]
        && request.resource.data.acceptedLevels is list
        && request.resource.data.acceptedLevels.size() > 0
        && request.resource.data.acceptedLevels.size() <= 5
        && request.resource.data.acceptedLevels.toSet().hasOnly(["novato", "d", "c", "b", "a"])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 280;
    }

    function validSinglesProposal() {
      return request.resource.data.keys().hasOnly([
          "fromPlayerId", "acceptedByPlayerId", "clubId", "proposedAt",
          "startsAt", "reservationTime", "court", "status", "format",
          "division", "acceptedLevels", "message", "city", "createdAt"
        ])
        && request.resource.data.format == "singles"
        && request.resource.data.acceptedByPlayerId == null
        && request.resource.data.status == "proposed";
    }

    /**
     * Parte de dobles: el creador declara los 4 jugadores, así que el partido
     * nace "accepted" y no pasa por solicitudes. `acceptedByPlayerId` se queda
     * a null a propósito — quién juega se lee de `participantIds`.
     */
    function validDoublesRecord() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          "fromPlayerId", "acceptedByPlayerId", "clubId", "proposedAt",
          "startsAt", "reservationTime", "court", "status", "format",
          "division", "acceptedLevels", "message", "city", "createdAt",
          "teamAIds", "teamBIds", "participantIds"
        ])
        && data.format == "doubles"
        && data.acceptedByPlayerId == null
        && data.status == "accepted"
        && data.teamAIds is list && data.teamAIds.size() == 2
        && data.teamBIds is list && data.teamBIds.size() == 2
        && data.participantIds is list && data.participantIds.size() == 4
        // Nadie puede repetir: ni jugar contra sí mismo ni rellenar hueco.
        && data.participantIds.toSet().size() == 4
        && data.participantIds.toSet() == data.teamAIds.concat(data.teamBIds).toSet()
        // Quien lo registra tiene que estar dentro, y en su propio equipo.
        && request.auth.uid in data.teamAIds
        // Los otros tres deben ser perfiles reales: si no, se podría inflar el
        // ranking de parejas con jugadores inventados.
        && exists(/databases/$(database)/documents/players/$(data.participantIds[0]))
        && exists(/databases/$(database)/documents/players/$(data.participantIds[1]))
        && exists(/databases/$(database)/documents/players/$(data.participantIds[2]))
        && exists(/databases/$(database)/documents/players/$(data.participantIds[3]));
    }

    /**
     * Quien confirma o disputa un resultado debe ser del equipo contrario al
     * que lo reportó. En dobles no basta con "que no sea el reportero": si no,
     * su propio compañero podría rubricar el marcador que acaban de meter.
     * En individuales no hay equipos declarados y equivale a la regla de
     * siempre (que sea la otra persona).
     */
    function isOpposingSide(data, reporterId, uid) {
      return !("teamAIds" in data)
        ? reporterId != uid
        : ((reporterId in data.teamAIds) != (uid in data.teamAIds));
    }

    // Antifraude: dos cuentas creadas en el mismo teléfono no pueden valorarse
    // entre ellas. La huella vive en `users/{uid}`, que es privado; las reglas
    // la leen con get() sin exponerla a ningún cliente. Si falta en alguno de
    // los dos lados no bloqueamos (cuentas antiguas, web o permiso denegado).
    function isDifferentDevice(authorId, targetId) {
      let authorPath = /databases/$(database)/documents/users/$(authorId);
      let targetPath = /databases/$(database)/documents/users/$(targetId);
      return !exists(authorPath)
        || !exists(targetPath)
        || !("deviceHash" in get(authorPath).data)
        || !("deviceHash" in get(targetPath).data)
        || get(authorPath).data.deviceHash != get(targetPath).data.deviceHash;
    }

    function hasValidReviewSkills(skills) {
      return skills is map
        && skills.keys().hasOnly(["consistency", "forehand", "backhand", "serve", "volley"])
        && skills.consistency is number && skills.consistency >= 1 && skills.consistency <= 10
        && skills.forehand is number && skills.forehand >= 1 && skills.forehand <= 10
        && skills.backhand is number && skills.backhand >= 1 && skills.backhand <= 10
        && skills.serve is number && skills.serve >= 1 && skills.serve <= 10
        && skills.volley is number && skills.volley >= 1 && skills.volley <= 10;
    }

    // --- users: privado por uid ---
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // --- players: directorio deportivo, no una colección pública ---
    match /players/{uid} {
      // El dueño siempre puede abrir su perfil. Para ver a otras personas se
      // exige una identidad verificada y las consultas deben estar acotadas;
      // así una cuenta de email desechable no puede descargar el directorio.
      allow get: if request.auth != null
        && (request.auth.uid == uid || hasVerifiedIdentity());
      allow list: if request.auth != null
        && hasVerifiedIdentity()
        && request.query.limit != null
        && request.query.limit <= 100;
      // Las métricas competitivas no son editables desde el cliente. Al crear
      // un perfil arrancan en valores neutrales; un backend de resultados
      // validado será quien pueda modificarlas en una fase posterior.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && hasValidPublicProfile(request.resource.data, uid)
        && request.resource.data.rating == 3
        && request.resource.data.responseRate == 100
        && hasValidSelfAssessment(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && (
          // Inscribirse o salir de una liga pública no debe fallar para perfiles
          // creados antes de añadir `verified`/`profileComplete`. Solo el dueño
          // puede cambiar este array y nunca puede guardar más de una liga por
          // cada uno de los cinco rangos.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "publicLeagues", "updatedAt"
            ])
            && request.resource.data.publicLeagues is list
            && request.resource.data.publicLeagues.size() <= 5
            // Las ligas públicas son por rango Y por ciudad. Los ids sin
            // sufijo de ciudad son los históricos: se siguen aceptando para
            // no invalidar las inscripciones anteriores a la separación
            // regional. Esta lista la genera `allPublicLeagueIds()`.
            && request.resource.data.publicLeagues.toSet().hasOnly([
              "l-novato-individual", "l-novato-individual-guatemala", "l-novato-individual-san-salvador",
              "l-novato-individual-barcelona", "l-d-individual", "l-d-individual-guatemala",
              "l-d-individual-san-salvador", "l-d-individual-barcelona", "l-c-individual",
              "l-c-individual-guatemala", "l-c-individual-san-salvador", "l-c-individual-barcelona",
              "l-b-individual", "l-b-individual-guatemala", "l-b-individual-san-salvador",
              "l-b-individual-barcelona", "l-a-individual", "l-a-individual-guatemala",
              "l-a-individual-san-salvador", "l-a-individual-barcelona"
            ])
          )
          ||
          (
            hasValidPublicProfile(request.resource.data, uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "name", "age", "gender", "clubIds", "city", "country",
              "accountRole",
              "latitude", "longitude", "level", "preferredFormats",
              "availability", "bio", "languages", "photoURL", "verified",
              "profileComplete", "seekingTeam", "seekingTeamClubId", "updatedAt",
              // Compatibilidad con perfiles antiguos que aún no tenían métricas.
              "rating", "responseRate",
              // Autoevaluación del onboarding (validada en hasValidSelfAssessment).
              "skills",
              // Inscripción del propio jugador a ligas públicas (una por rango).
              "publicLeagues"
            ])
            && hasValidSelfAssessment(request.resource.data)
            && (
              (!("rating" in resource.data) && request.resource.data.rating == 3)
              || (("rating" in resource.data) && request.resource.data.rating == resource.data.rating)
            )
            && (
              (!("responseRate" in resource.data) && request.resource.data.responseRate == 100)
              || (("responseRate" in resource.data) && request.resource.data.responseRate == resource.data.responseRate)
            )
          )
        );
      // Solo el dueño puede darse de baja.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // --- clubs: catálogo público de lectura, escritura solo admin (vía console) ---
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if false;
    }

    // --- matches ---
    // Propuestas de partido ABIERTAS: no van dirigidas a una persona concreta.
    // - Cualquiera autenticado puede leer las propuestas abiertas (nadie las ha
    //   aceptado) y, por supuesto, las suyas (creadas o aceptadas).
      // - Solo el creador puede publicar; la plaza se asigna después de una
      //   solicitud pendiente que el propio creador acepta.
    match /matches/{matchId} {
      // En `create` no existe `resource` todavía, validamos sobre request.resource.data.
      // Dos formas de nacer: la propuesta abierta de individuales (se busca
      // rival) y el parte de dobles, donde el creador declara la alineación
      // completa y el partido nace ya cerrado.
      allow create: if request.auth != null
        && hasValidMatchBase()
        && (validSinglesProposal() || validDoublesRecord());

      // Lectura: propuestas abiertas (nadie las ha aceptado) o las propias.
      allow get: if request.auth != null
        && (
          isMatchParticipant(resource.data, request.auth.uid)
          || (
            "acceptedByPlayerId" in resource.data
            && "status" in resource.data
            && resource.data.acceptedByPlayerId == null
            && resource.data.status == "proposed"
          )
        );

      // Cada forma de listar va en una regla independiente. Una única
      // expresión OR intentaba leer campos ausentes de modelos históricos y
      // Firestore convertía esa evaluación en permission-denied.
      allow list: if request.auth != null
        && resource.data.fromPlayerId == request.auth.uid;
      allow list: if request.auth != null
        && resource.data.acceptedByPlayerId == request.auth.uid;
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow list: if request.auth != null
        && resource.data.acceptedByPlayerId == null
        && resource.data.status == "proposed";

      // Transiciones permitidas y mínimas:
      // - creador: propuesta/aceptada → cancelada;
      // - creador: propuesta libre → aceptada para una solicitud pendiente;
      // - rival que aceptó: aceptada → propuesta libre.
      // Ninguna transición puede modificar reserva, autor, nivel o mensaje.
      allow update: if request.auth != null
        && (request.resource.data.fromPlayerId == resource.data.fromPlayerId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "acceptedByPlayerId", "status", "resultStatus", "result",
            "validation", "updatedAt"
          ])
        && (
          (
            request.auth.uid == resource.data.fromPlayerId
            && resource.data.status in ["proposed", "accepted"]
            && request.resource.data.status == "declined"
            && request.resource.data.acceptedByPlayerId == resource.data.acceptedByPlayerId
          )
          || (
            request.auth.uid == resource.data.fromPlayerId
            && resource.data.acceptedByPlayerId == null
            && resource.data.status == "proposed"
            && request.resource.data.status == "accepted"
            && request.resource.data.acceptedByPlayerId is string
            && exists(/databases/$(database)/documents/matchJoinRequests/$(matchId + "_" + request.resource.data.acceptedByPlayerId))
            && get(/databases/$(database)/documents/matchJoinRequests/$(matchId + "_" + request.resource.data.acceptedByPlayerId)).data.status == "pending"
          )
          || (
            resource.data.acceptedByPlayerId == request.auth.uid
            && resource.data.status == "accepted"
            && request.resource.data.acceptedByPlayerId == null
            && request.resource.data.status in ["proposed", "declined"]
          )
          ||
          (
            // Resultado: cualquier jugador de un partido aceptado puede
            // reportarlo; solo alguien del equipo contrario al reportero puede
            // confirmarlo o disputarlo. En dobles los participantes salen de
            // `participantIds`, no de from/accepted.
            resource.data.status == "accepted"
            && isMatchParticipant(resource.data, request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["resultStatus", "result", "validation", "updatedAt"])
            && (
              (
                (
                  !("resultStatus" in resource.data)
                  || resource.data.resultStatus in ["awaiting_result", "disputed"]
                )
                && request.resource.data.resultStatus == "awaiting_validation"
                && request.resource.data.result is map
                && request.resource.data.result.keys().hasOnly([
                  "winner", "sets", "reportedById", "reportedByName", "reportedAt"
                ])
                && request.resource.data.result.reportedById == request.auth.uid
                && request.resource.data.result.reportedByName is string
                && request.resource.data.result.reportedByName.size() <= 80
                && request.resource.data.result.winner in ["A", "B"]
                && request.resource.data.result.sets is list
                && request.resource.data.result.sets.size() >= 1
                && request.resource.data.result.sets.size() <= 5
              )
              ||
              (
                resource.data.resultStatus == "awaiting_validation"
                && isOpposingSide(resource.data, resource.data.result.reportedById, request.auth.uid)
                && request.resource.data.result == resource.data.result
                && request.resource.data.resultStatus == "disputed"
              )
              ||
              (
                resource.data.resultStatus == "awaiting_validation"
                && isOpposingSide(resource.data, resource.data.result.reportedById, request.auth.uid)
                && request.resource.data.result == resource.data.result
                && request.resource.data.resultStatus == "validated"
                && request.resource.data.validation.playerId == request.auth.uid
                // El histórico se escribe en la misma operación: individuales
                // al ranking de jugadores, dobles al de parejas.
                && (
                  resource.data.format == "doubles"
                    ? existsAfter(/databases/$(database)/documents/doublesRankingResults/$(matchId))
                    : existsAfter(/databases/$(database)/documents/rankingResults/$(matchId))
                )
              )
            )
          )
        );

      // El creador puede borrar la propuesta (la UI ofrece cancelar).
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.fromPlayerId;
    }

    // Valoraciones dirigidas. El id determinista impide duplicar el voto de
    // un autor sobre una persona dentro del mismo partido.
    match /matchReviews/{reviewId} {
      allow get: if request.auth != null && hasVerifiedIdentity();
      allow list: if request.auth != null
        && hasVerifiedIdentity()
        && request.query.limit != null
        && request.query.limit <= 100;

      allow create: if request.auth != null
        && hasVerifiedIdentity()
        && reviewId == request.resource.data.matchId + "_" + request.auth.uid + "_" + request.resource.data.targetId
        && request.resource.data.keys().hasOnly([
          "id", "matchId", "authorId", "authorName", "targetId", "targetName",
          "stars", "skillRatings", "createdAt", "updatedAt"
        ])
        && request.resource.data.id == reviewId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && hasValidReviewSkills(request.resource.data.skillRatings)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.authorName
          == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.name
        && request.resource.data.targetName
          == get(/databases/$(database)/documents/players/$(request.resource.data.targetId)).data.name
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == "accepted"
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.resultStatus == "validated"
        && isMatchParticipant(
          get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data,
          request.auth.uid
        )
        && isMatchParticipant(
          get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data,
          request.resource.data.targetId
        )
        && isDifferentDevice(request.auth.uid, request.resource.data.targetId);

      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["stars", "skillRatings", "updatedAt"])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && hasValidReviewSkills(request.resource.data.skillRatings)
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // Resultado competitivo inmutable. Se crea en la misma transacción en la
    // que el rival confirma el marcador y permite calcular rankings sin un
    // backend de pago ni confiar en puntos editables del perfil.
    // Histórico de dobles, separado del individual: la unidad que clasifica es
    // la pareja. Inmutable igual que su equivalente de individuales.
    match /doublesRankingResults/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "matchId", "city", "division", "teamAIds", "teamBIds",
          "winnerTeam", "playedAt", "validatedById", "createdAt"
        ])
        && request.resource.data.matchId == matchId
        && request.resource.data.validatedById == request.auth.uid
        && getAfter(/databases/$(database)/documents/matches/$(matchId)).data.resultStatus == "validated"
        && getAfter(/databases/$(database)/documents/matches/$(matchId)).data.format == "doubles"
        && request.resource.data.teamAIds
          == getAfter(/databases/$(database)/documents/matches/$(matchId)).data.teamAIds
        && request.resource.data.teamBIds
          == getAfter(/databases/$(database)/documents/matches/$(matchId)).data.teamBIds
        && request.resource.data.city
          == getAfter(/databases/$(database)/documents/matches/$(matchId)).data.city
        && request.resource.data.division
          == getAfter(/databases/$(database)/documents/matches/$(matchId)).data.division
        && request.resource.data.winnerTeam
          == getAfter(/databases/$(database)/documents/matches/$(matchId)).data.result.winner
        && request.resource.data.winnerTeam in ["A", "B"]
        // Lo escribe quien valida, que es del equipo contrario al reportero.
        && request.auth.uid in request.resource.data.teamAIds.concat(request.resource.data.teamBIds)
        && request.auth.uid != getAfter(/databases/$(database)/documents/matches/$(matchId)).data.result.reportedById;
      allow update, delete: if false;
    }

    match /rankingResults/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "matchId", "city", "division", "playerAId", "playerBId",
          "winnerId", "playedAt", "validatedById", "createdAt"
        ])
        && request.resource.data.matchId == matchId
        && request.resource.data.validatedById == request.auth.uid
        && getAfter(/databases/$(database)/documents/matches/$(matchId)).data.resultStatus == "validated"
        && request.resource.data.playerAId
          == getAfter(/databases/$(database)/documents/matches/$(matchId)).data.fromPlayerId
        && request.resource.data.playerBId
          == getAfter(/databases/$(database)/documents/matches/$(matchId)).data.acceptedByPlayerId
        && request.resource.data.city
          == getAfter(/databases/$(database)/documents/matches/$(matchId)).data.city
        && request.resource.data.division
          == getAfter(/databases/$(database)/documents/matches/$(matchId)).data.division
        && request.resource.data.winnerId in [
          request.resource.data.playerAId, request.resource.data.playerBId
        ]
        && request.auth.uid in [
          request.resource.data.playerAId, request.resource.data.playerBId
        ]
        && request.auth.uid != getAfter(/databases/$(database)/documents/matches/$(matchId)).data.result.reportedById;
      allow update, delete: if false;
    }

    match /matchJoinRequests/{requestId} {
      allow create: if request.auth != null
        && requestId == request.resource.data.matchId + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly([
          "id", "matchId", "ownerId", "requesterId", "requesterName",
          "requesterLevel", "status", "createdAt", "createdAtServer"
        ])
        && request.resource.data.id == requestId
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.requesterName.size() <= 80
        && request.resource.data.requesterLevel in ["novato", "d", "c", "b", "a"]
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && request.resource.data.requesterName
          == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.name
        && request.resource.data.requesterLevel
          == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.level
        && (
          !("isDemo" in get(/databases/$(database)/documents/players/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/players/$(request.auth.uid)).data.isDemo != true
        )
        && request.resource.data.ownerId == get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.fromPlayerId
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == "proposed"
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.acceptedByPlayerId == null
        && (
          (
            "acceptedLevels" in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data
            && request.resource.data.requesterLevel in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.acceptedLevels
          )
          || (
            !("acceptedLevels" in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data)
            && request.resource.data.requesterLevel == get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.division
          )
        );

      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || resource.data.requesterId == request.auth.uid);

      allow update: if request.auth != null
        && (
          (
            resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
            && resource.data.status == "pending"
            && request.resource.data.status in ["accepted", "declined"]
          )
          || (
            resource.data.requesterId == request.auth.uid
            && resource.data.status == "declined"
            && request.resource.data.status == "pending"
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "createdAt", "createdAtServer", "updatedAt"])
            && exists(/databases/$(database)/documents/players/$(request.auth.uid))
            && resource.data.requesterName
              == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.name
            && resource.data.requesterLevel
              == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.level
            && (
              !("isDemo" in get(/databases/$(database)/documents/players/$(request.auth.uid)).data)
              || get(/databases/$(database)/documents/players/$(request.auth.uid)).data.isDemo != true
            )
            && request.resource.data.ownerId == get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.fromPlayerId
            && get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.status == "proposed"
            && get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.acceptedByPlayerId == null
            && (
              (
                "acceptedLevels" in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data
                && resource.data.requesterLevel in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.acceptedLevels
              )
              || (
                !("acceptedLevels" in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data)
                && resource.data.requesterLevel == get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.division
              )
            )
          )
        );
    }

    // --- Muro profesional de entrenadores ---
    match /coachAds/{adId} {
      // Los anuncios activos forman el muro. El propietario también puede ver
      // su borrador mientras se procesa el pago.
      allow read: if request.auth != null
        && (resource.data.status == "active" || resource.data.ownerId == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.accountRole in ["coach", "both"]
        && request.resource.data.id == adId
        && request.resource.data.status == "pending_payment"
        && request.resource.data.plan in ["week", "month"]
        && request.resource.data.coachName is string
        && request.resource.data.coachName.size() > 0
        && request.resource.data.headline is string
        && request.resource.data.headline.size() > 0
        && request.resource.data.headline.size() <= 90
        && request.resource.data.bio is string
        && request.resource.data.bio.size() > 0
        && request.resource.data.bio.size() <= 700
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.clubIds is list
        && request.resource.data.clubIds.size() <= 8
        && request.resource.data.specialties is list
        && request.resource.data.specialties.size() <= 8;

      // El cliente nunca activa ni extiende un anuncio; eso lo hace el
      // verificador server-side después de consultar la tienda.
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status == resource.data.status
        && request.resource.data.activeFrom == resource.data.activeFrom
        && request.resource.data.expiresAt == resource.data.expiresAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      match /private/{privateId} {
        allow create, update: if request.auth != null
          && privateId == "contact"
          && getAfter(/databases/$(database)/documents/coachAds/$(adId)).data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            "ownerId", "phone", "whatsapp", "email", "website", "updatedAt"
          ]);
        allow read: if request.auth != null
          && privateId == "contact"
          && (
            resource.data.ownerId == request.auth.uid
            || exists(/databases/$(database)/documents/coachInterests/$(adId + "_" + request.auth.uid))
          );
      }
    }

    match /coachInterests/{interestId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "coachAdId", "coachOwnerId", "interestedUserId",
          "interestedName", "interestedPhotoURL", "createdAt"
        ])
        && request.resource.data.interestedUserId == request.auth.uid
        && interestId == request.resource.data.coachAdId + "_" + request.auth.uid
        && request.resource.data.coachOwnerId
          == get(/databases/$(database)/documents/coachAds/$(request.resource.data.coachAdId)).data.ownerId
        && get(/databases/$(database)/documents/coachAds/$(request.resource.data.coachAdId)).data.status == "active"
        && get(/databases/$(database)/documents/coachAds/$(request.resource.data.coachAdId)).data.expiresAt > request.time
        && request.resource.data.interestedName
          == get(/databases/$(database)/documents/players/$(request.auth.uid)).data.name;
      allow read: if request.auth != null
        && (
          resource.data.interestedUserId == request.auth.uid
          || (
            resource.data.coachOwnerId == request.auth.uid
            && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.accountRole in ["coach", "both"]
          )
        );
      allow update: if request.auth != null
        && resource.data.coachOwnerId == request.auth.uid
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.accountRole in ["coach", "both"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
      allow delete: if false;
    }

    // Los comprobantes de compra viven en `iapPurchases` y solo el backend
    // puede crearlos. Al no declarar una regla específica quedan cubiertos por
    // la denegación por defecto del final del archivo.

    // La liga es visible para usuarios autenticados que tengan el enlace. Las
    // altas se procesan en backend para comprobar el código secreto y el cupo.
    match /privateLeagues/{leagueId} {
      // El enlace permite abrir una liga concreta; la colección completa no se
      // puede enumerar. Las consultas de "mis ligas" filtran por memberIds.
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create, update: if false;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      match /private/{privateId} {
        allow read: if request.auth != null
          && privateId == "invite"
          && request.auth.uid in get(/databases/$(database)/documents/privateLeagues/$(leagueId)).data.memberIds;
        allow write: if false;
      }
    }

    match /androidBetaRequests/{userId} {
      allow create: if request.auth != null
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160;
      allow get: if request.auth != null && userId == request.auth.uid;
      allow list, update, delete: if false;
    }

    // Denegar por defecto todo lo demás.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
